{
  "name": "trivia-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev api/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "build:api": "esbuild --bundle src/server.ts --format=esm --outfile=dist/_worker.js",
    "preview": "vite preview",
    "prisma:generate": "npx prisma generate",
    "publish:api": "wrangler publish api/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.3.1",
    "@types/howler": "^2.2.7",
    "@vueuse/core": "^8.3.1",
    "hono": "^3.6.3",
    "howler": "^2.2.3",
    "http-status": "^1.7.0",
    "pinia": "^2.0.12",
    "prisma": "^5.3.1",
    "vue": "^3.2.25",
    "vue-router": "^4.0.14",
    "worker-auth-providers": "^0.0.13-beta.4",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^20.6.2",
    "@vitejs/plugin-vue": "^2.2.0",
    "autoprefixer": "^10.4.4",
    "postcss": "^8.4.12",
    "sass": "^1.50.1",
    "tailwindcss": "^3.0.23",
    "typescript": "^4.5.4",
    "vite": "^2.8.0",
    "vue-tsc": "^0.29.8"
  }
}
